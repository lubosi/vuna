# --- Public (safe to expose to the browser, NEXT_PUBLIC_* only) ---
NEXT_PUBLIC_SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY="<PLACEHOLDER>"
NEXT_PUBLIC_OPS_WHATSAPP_E164=+447958052301
NEXT_PUBLIC_POSTHOG_KEY="<PLACEHOLDER>"
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN="<PLACEHOLDER>"

# --- Server-only. Never reference these in a client component. ---
SUPABASE_SERVICE_ROLE_KEY="<PLACEHOLDER>"
OPS_CONSOLE_PASSWORD="<PLACEHOLDER>"
SENTRY_DSN="<PLACEHOLDER>"

# --- Used by the Supabase CLI (db push, gen types), not the app at runtime ---
SUPABASE_PROJECT_REF="<PLACEHOLDER>"
SUPABASE_DB_URL=postgresql://postgres:<PASSWORD>@db.<SUPABASE_PROJECT_REF>.supabase.co:5432/postgres

# --- Used by .mcp.json's supabase server, not the app at runtime ---
SUPABASE_ACCESS_TOKEN="<PLACEHOLDER>"

# --- Used by .mcp.json's github server, not the app at runtime ---
GITHUB_PERSONAL_ACCESS_TOKEN="<PLACEHOLDER>"
